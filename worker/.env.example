NODE_ENV=production

REDIS_URL=redis://default:<password>@<host>:<port>

# Must match the server's WORKER_CALLBACK_SECRET exactly.
SERVER_URL=https://your-render-api.onrender.com
WORKER_CALLBACK_SECRET=change_me_worker_secret

# Docker images built from worker/docker/*.Dockerfile — see worker/docker/build.sh
JS_RUNNER_IMAGE=mockmate-runner-js:latest
CPP_RUNNER_IMAGE=mockmate-runner-cpp:latest
