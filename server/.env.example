NODE_ENV=development
PORT=5000

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mockmate

JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

CLIENT_URL=http://localhost:5173

REDIS_URL=redis://default:<password>@<host>:<port>

# Shared secret the worker must send back when posting verdicts — server rejects
# any /internal/* request without it. Generate a long random string for production.
WORKER_CALLBACK_SECRET=change_me_worker_secret

GEMINI_API_KEY=
